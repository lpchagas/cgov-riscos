# Dependências e artefatos de compilação
node_modules/
dist/
.superpowers/

# Variáveis de ambiente com segredos locais
.env
.env.local
.env.*.local

# Arquivos temporários do Obsidian por usuário
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Logs
*.log
npm-debug.log*

# Metadados do Windows gerados ao copiar arquivos para o WSL
*:Zone.Identifier

# Pacote local da skill de gestão de riscos (não versionar)
cgov-gestao-riscos-v4.zip

# Saídas da varredura de acessibilidade (Playwright)
playwright-report/
test-results/

# Exportações locais das listas do SharePoint (podem conter dados pessoais — nunca versionar)
_temp/

# Variáveis do perfil real-local do container (contém a chave anon local; nunca versionar)
.env.conteiner-local

# Pacote de publicação gerado localmente (Power Pages)
publicacao/

# Skills de agentes: links simbólicos com caminho absoluto (não funcionam em outro computador)
.agents/
.claude/skills/
.opencode/
copilot/

# Plugins do Obsidian (código de terceiros) e cache de ferramentas de IA
.obsidian/plugins/
.copilot/

# Preferências pessoais do Obsidian (visual, grafo e lista de plugins)
.obsidian/appearance.json
.obsidian/core-plugins.json
.obsidian/graph.json
.obsidian/community-plugins.json

# Configuração local do Claude Code (pode conter permissões e dados da máquina)
.claude/settings.local.json
