-- ============================================================================
-- AJUDANTES DOS TESTES DE BANCO (pgTAP) — Etapa B1, Tarefa 5
-- ============================================================================
-- EXPLICAÇÃO DIDÁTICA:
-- Este arquivo NÃO é um teste. Ele termina em `.psql` (e não em `.sql`) de
-- propósito: o `supabase test db` roda como teste todo arquivo `.sql` da
-- pasta `supabase/tests/`. Os testes que precisam dele o incluem assim:
--
--     \ir ajudantes.psql
--
-- (`\ir` = "include relative": o psql lê o arquivo da mesma pasta do teste.)
--
-- As funções ficam no esquema `pg_temp` (temporário da sessão): somem sozinhas
-- quando a conexão do teste termina e nunca vão para o banco de verdade.
-- Por isso são chamadas com o prefixo: `select pg_temp.entrar_como('...');`.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- entrar_como(email): "faz de conta" que o usuário fictício está logado.
-- ----------------------------------------------------------------------------
-- O Supabase descobre quem está logado por duas coisas:
--   1) o papel (role) do banco: `authenticated` para quem fez login;
--   2) o "crachá" (JWT), cujo campo `sub` é o id do usuário. A função
--      `auth.uid()` lê esse campo de `request.jwt.claims`.
-- Aqui nós ajustamos as duas coisas à mão, só até o fim da transação
-- (o `true` do set_config = "local", como `set local`).
--
-- Exemplo:
--   select pg_temp.entrar_como('gestor.uc@radar.test');
--   select auth.uid();   -- 00000000-0000-4000-a000-000000000001
create or replace function pg_temp.entrar_como(p_email text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid;
begin
  -- Volta ao usuário da sessão (postgres) para poder ler auth.users,
  -- caso o teste já esteja "logado" como outra pessoa.
  perform set_config('role', 'none', true);

  select u.id into v_id from auth.users u where u.email = p_email;
  if v_id is null then
    raise exception 'Ajudante de teste: usuário % não existe em auth.users (rodou npm run db:reset?)', p_email;
  end if;

  -- Crachá (JWT) de mentira, com o id do usuário no campo `sub`.
  perform set_config('request.jwt.claims',
    json_build_object('sub', v_id, 'role', 'authenticated', 'email', p_email)::text, true);
  -- E o papel de quem fez login.
  perform set_config('role', 'authenticated', true);
  return v_id;
end;
$$;

-- ----------------------------------------------------------------------------
-- entrar_como_anonimo(): visitante sem login (papel `anon`, sem `sub`).
-- ----------------------------------------------------------------------------
create or replace function pg_temp.entrar_como_anonimo()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- ----------------------------------------------------------------------------
-- sair(): volta a ser o administrador do teste (postgres), sem crachá.
-- ----------------------------------------------------------------------------
-- Útil antes de alterar dados "à força" no meio do teste (ex.: criar um ciclo).
create or replace function pg_temp.sair()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- ----------------------------------------------------------------------------
-- linhas_afetadas(sql): roda um UPDATE/DELETE e devolve QUANTAS linhas mudou.
-- ----------------------------------------------------------------------------
-- Por que existe? Quando a RLS barra um UPDATE ou DELETE, o PostgreSQL NÃO dá
-- erro: ele simplesmente "não encontra" a linha e muda 0 linhas. Para provar
-- que a trava funcionou, o teste precisa contar as linhas. (Já o INSERT
-- barrado dá erro 42501, testado com throws_ok.) Tarefa 6.
--
-- Exemplo:
--   select pg_temp.entrar_como('gr@radar.test');
--   select pg_temp.linhas_afetadas($$update public.riscos set causas = 'x'
--                                     where codigo_radar = 'RADAR-DEMO-UC-CT'$$);  -- 0
create or replace function pg_temp.linhas_afetadas(p_sql text)
returns integer
language plpgsql
as $$
declare
  v_linhas integer;
begin
  execute p_sql;
  get diagnostics v_linhas = row_count;
  return v_linhas;
end;
$$;

-- ----------------------------------------------------------------------------
-- dar_tratamento(risco): inclui UMA ação 5W2H (Mitigar) no risco, se ele ainda
-- não tem nenhuma ação que não seja "Aceitar", e UM KRI completo do objeto
-- ligado a ele, se ele ainda não tem nenhum (LAC-03).
-- ----------------------------------------------------------------------------
-- Por que existe? Desde a LAC-13 (migração 20261122002), o risco crítico só
-- anda no fluxo (enviar, validar, homologar) com estratégia diferente de
-- "Aceitar" e com pelo menos uma ação de tratamento; desde a LAC-03
-- (20261122004), também com pelo menos um KRI completo. Os testes do fluxo que
-- são anteriores a elas testam OUTRAS regras (quem valida, quem homologa...)
-- e usam riscos sem ação nem KRI. Este ajudante dá a eles o tratamento mínimo,
-- para que continuem testando o que testavam. A trava em si é provada no 100
-- e no 110.
-- O sinal radar.fluxo fica ligado só durante os INSERTs: incluir a ação ou o
-- KRI não deve reabrir (aprovado) nem ser recusado (em validação) pela trava.
-- Ex.: select pg_temp.dar_tratamento(id) from public.riscos;
create or replace function pg_temp.dar_tratamento(p_risco uuid)
returns void
language plpgsql
as $$
declare
  v_sinal text := coalesce(current_setting('radar.fluxo', true), '');
  v_kri   uuid;
begin
  perform set_config('radar.fluxo', 'on', true);
  if not exists (select 1 from public.respostas_tratamento t
                  where t.risco_id = p_risco and t.estrategia <> 'Aceitar') then
    insert into public.respostas_tratamento
      (risco_id, estrategia, acao_o_que, responsavel_quem, prazo_quando, procedimento_como)
    values (p_risco, 'Mitigar', 'ação de tratamento de demonstração', 'Chefia da unidade',
            '2027-06-30', 'procedimento de demonstração');
  end if;
  if not exists (select 1 from public.kri_riscos l
                   join public.indicadores_kri k on k.id = l.kri_id
                  where l.risco_id = p_risco and public.fn_kri_completo(k)) then
    insert into public.indicadores_kri
      (objeto_id, nome_indicador, formula_calculo, fonte_dados, periodicidade,
       limite_alerta, responsavel_medicao)
    select r.objeto_id, 'KRI de demonstração (tratamento mínimo)', 'atrasados / total',
           'Planilha da unidade', 'Mensal', '> 10%', 'Chefia da unidade'
      from public.riscos r where r.id = p_risco
    returning id into v_kri;
    insert into public.kri_riscos (kri_id, risco_id) values (v_kri, p_risco);
  end if;
  perform set_config('radar.fluxo', v_sinal, true);
end;
$$;

-- dar_tratamento_a_todos(): o mesmo, para todos os riscos que existem agora
-- (ex.: os da semente de demonstração; só os críticos dela têm ação e KRI).
create or replace function pg_temp.dar_tratamento_a_todos()
returns void
language sql
as $$
  select pg_temp.dar_tratamento(r.id) from public.riscos r;
$$;

-- ----------------------------------------------------------------------------
-- publicar_dar_teste(categoria, apetite): LAC-08 — grava o apetite da DAR
-- como DONO do banco, só nos testes.
-- ----------------------------------------------------------------------------
-- Desde a LAC-08, ninguém logado (nem a CGOV) faz UPDATE em categorias_risco:
-- o apetite só muda pela RPC registrar_portaria_dar, no fim do rito
-- (minuta → CTGRIC → CIG → portaria). Muitos testes só precisam de "um
-- apetite qualquer" para conferir o cálculo e o gatilho de reavaliação; para
-- eles, este ajudante faz o UPDATE como dono e volta ao papel de antes.
-- O crachá (request.jwt.claims) NÃO muda: auth.uid() continua sendo quem
-- "entrou", então o histórico e a trilha guardam o mesmo autor de antes.
-- Exemplo:
--   select pg_temp.entrar_como('cgov@radar.test');
--   select pg_temp.publicar_dar_teste(2, 'baixo');   -- o gatilho reavalia
create or replace function pg_temp.publicar_dar_teste(p_categoria int, p_apetite text)
returns void
language plpgsql
as $$
declare
  v_papel text := coalesce(nullif(current_setting('role', true), ''), 'none');
begin
  perform set_config('role', 'none', true);
  update public.categorias_risco set apetite_declarado = p_apetite where id = p_categoria;
  perform set_config('role', v_papel, true);
end;
$$;

-- ----------------------------------------------------------------------------
-- publicar_dar_pelo_rito(categorias): LAC-08 — percorre o rito INTEIRO da DAR
-- pelas RPCs, como a CGOV faria pelas telas, com todas as datas = hoje.
-- ----------------------------------------------------------------------------
-- minuta → CTGRIC favorável → CIG aprova → portaria "T-<nº da minuta> (teste)".
-- Quem chama precisa ter "entrado" como a CGOV (entrar_como('cgov@radar.test')).
-- Exemplo:
--   select pg_temp.publicar_dar_pelo_rito(
--     '[{"categoria_id": 2, "apetite_proposto": "baixo", "justificativa": "Teste."}]');
create or replace function pg_temp.publicar_dar_pelo_rito(p_categorias jsonb)
returns void
language plpgsql
as $$
declare
  v_minuta uuid;
  v_hoje   date := public.fn_hoje();
begin
  v_minuta := public.salvar_minuta_dar(jsonb_build_object('categorias', p_categorias));
  perform public.encaminhar_minuta_dar_ctgric(v_hoje);
  perform public.registrar_manifestacao_ctgric_dar('favoravel', v_hoje, null);
  perform public.registrar_deliberacao_cig_dar('aprovada', v_hoje, null);
  perform public.registrar_portaria_dar(
    'T-' || (select m.numero from public.dar_minutas m where m.id = v_minuta) || ' (teste)', v_hoje, null);
end;
$$;
