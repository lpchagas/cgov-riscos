# =============================================================================
# Variáveis do perfil "real-local" do Docker Compose (container + Supabase local)
# =============================================================================
# Como usar:
#   1) Suba o banco local:   npm run db:start
#   2) Copie este arquivo:   cp .env.conteiner-local.example .env.conteiner-local
#   3) Confira a URL (já vem com a do Supabase local) e preencha a chave anon
#      (as duas aparecem em `npx supabase status`).
#   4) Suba o container:
#      docker compose --env-file .env.conteiner-local --profile real-local up -d --build
#   5) Abra http://localhost:8081
#
# O Vite grava estas duas variáveis dentro do JavaScript NA HORA DO BUILD.
# Use SOMENTE a chave "anon" (pública). NUNCA a service_role.
# O arquivo .env.conteiner-local está no .gitignore: não o versione.
# =============================================================================

# Endereço do Supabase visto PELO NAVEGADOR (no Supabase local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Chave anon (pública) do Supabase
VITE_SUPABASE_ANON_KEY=
