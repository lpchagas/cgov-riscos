{
  "name": "cgov-riscos-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema Web de Gestão de Riscos do ICMBio — RADAR (Rede de Avaliação, Diagnóstico e Ação em Riscos)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run sync:estrutura -- --sim && docker exec -i supabase_db_cgov-riscos psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seed-demonstracao.sql",
    "test:db": "supabase test db",
    "sync:estrutura": "vite-node scripts/sync-estrutura/index.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@govbr-ds/core": "^3.7.0",
    "@supabase/supabase-js": "^2.46.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "csv-parse": "7.0.3",
    "jsdom": "^25.0.1",
    "playwright-core": "1.64.1",
    "supabase": "2.122.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.8"
  }
}
